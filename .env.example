# TRACE AI Environment Configuration

# Jev AI API Key (from https://typesafe.ai)
# If left blank, TRACE AI operates in deterministic Demo Mode
JEV_API_KEY=your_typesafe_jev_api_key_here

# Jev API URL (Default: https://api.typesafe.ai/v1/systemone)
JEV_API_URL=https://api.typesafe.ai/v1/systemone

# Explicit Demo Mode Toggle (true / false)
DEMO_MODE=true

# SQLite Database connection string
DATABASE_URL=sqlite:///./trace_ai.db

# ML Anomaly Detection (Isolation Forest) Contamination Rate (0.01 - 0.3)
DEFAULT_CONTAMINATION=0.08

# Incident Correlation Sliding Time Window (seconds)
DEFAULT_CORRELATION_WINDOW_SECONDS=120

# Ingestion Maximum File Size Limit (MB)
MAX_FILE_SIZE_MB=25
